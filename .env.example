# Скопируйте в .env и заполните. НЕ коммитить .env!
DJANGO_SECRET_KEY=change-me-to-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Токен бота от @BotFather (после компрометации — перевыпустить!)
BOT_TOKEN=
# Общий секрет backend <-> bot/mini-app для менеджерских ручек
CRM_API_KEY=change-me-to-random-32-chars

CORS_ALLOW_ALL_ORIGINS=True
# База для prod (иначе SQLite):
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Ошибки в Sentry (опционально):
# SENTRY_DSN=
# Для prod:
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=https://your-frontend.com
# CSRF_TRUSTED_ORIGINS=https://your-backend.com
